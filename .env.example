# ============================================================
# Loom Agent v0.1 · 配置模板
# 用法：复制为 .env 并填入真实 Key。.env 已在 .gitignore 中。
# ============================================================

# ---- 模型凭证（C5：双模型）----
XFYUN_API_KEY=          # 讯飞 MaaS（当前默认）
BAILIAN_API_KEY=
DEEPSEEK_API_KEY=

# ---- 默认模型：bailian | deepseek ----
LOOM_DEFAULT_MODEL=deepseek

# ---- 服务（P10 起用）----
LOOM_HOST=127.0.0.1
LOOM_PORT=8765

# ---- 预算（C2 / C3）----
# 轮次上限，防无限循环 / 控成本
LOOM_MAX_TURNS=20
# 最少证据数，没观察环境不许回答
LOOM_MIN_EVIDENCE=1
# 连续相同工具调用熔断阈值
LOOM_MAX_SAME_CALL_REPEAT=3
# 总时间预算（秒）
LOOM_MAX_SECONDS=300
# 审批超时（秒）。CLI 验证期可临时调小（如 10）便于测试
LOOM_APPROVAL_TIMEOUT=180

# ---- 日志 ----
LOOM_LOG_LEVEL=INFO

# 主模型
LOOM_MODEL=spark-x2.6
# 有序候选模型（同一个 Key，按顺序用；某个没额度/下线就自动换下一个）
# 逗号或空格分隔，第一个是主模型
LOOM_MODELS=spark-x2.6
