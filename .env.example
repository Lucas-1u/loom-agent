# ============================================================
# Loom Agent v0.1 · 配置模板
# 用法：复制为 .env 并填入真实 Key。.env 已在 .gitignore 中。
# ============================================================

# ---- 模型凭证（C5：双模型）----
XFYUN_API_KEY=          # 讯飞 MaaS（当前默认）
BAILIAN_API_KEY=
DEEPSEEK_API_KEY=

# ---- 默认模型：bailian | deepseek ----
LOOM_DEFAULT_MODEL=deepseek

# ---- 服务（P10 起用）----
LOOM_HOST=127.0.0.1
LOOM_PORT=8765

# ---- 预算（C2 / C3）----
# 轮次上限，防无限循环 / 控成本
LOOM_MAX_TURNS=20
# 最少证据数，没观察环境不许回答
LOOM_MIN_EVIDENCE=1
# 连续相同工具调用熔断阈值
LOOM_MAX_SAME_CALL_REPEAT=3
# 总时间预算（秒）
LOOM_MAX_SECONDS=300
# 审批超时（秒）。CLI 验证期可临时调小（如 10）便于测试
LOOM_APPROVAL_TIMEOUT=180

# ---- 日志 ----
LOOM_LOG_LEVEL=INFO

# 主模型
LOOM_MODEL=spark-x2.6
# 有序候选模型（同一个 Key，按顺序用；某个没额度/下线就自动换下一个）
# 逗号或空格分隔，第一个是主模型
LOOM_MODELS=spark-x2.6

# 编排引擎：graph（默认，LangGraph 引擎，需装 langgraph）| legacy（原有 _loop，兜底，需显式指定）
LOOM_ORCHESTRATOR=legacy

# ---- M3：项目知识检索（SQLite FTS5 全文关键词检索）----
# LOOM_RAG=0 完全关闭（不建索引、不注册 search_docs、不预检索）
# LOOM_RAG_AUTO=0 只关"任务开始自动检索"，search_docs 工具仍可用
# LOOM_RAG_DB 索引库路径，默认 sandbox/index/knowledge.db（按 workspace 隔离数据）
LOOM_RAG=1
LOOM_RAG_AUTO=1
# LOOM_RAG_DB=D:/Loom_agent/loom/sandbox/index/knowledge.db
# LOOM_RAG_TOP_K=4
# LOOM_RAG_HIT_CHARS=700
# LOOM_RAG_CONTEXT_CHARS=2600
# LOOM_RAG_MAX_FILE_KB=256
# LOOM_RAG_MAX_FILES=400

# ---- M4.1：MCP Client（默认关闭；打开后才会读配置文件并启动本地 Server）----
# LOOM_MCP=0          关闭（默认）：不读配置、不启动进程、注册表里没有 MCP 工具
# LOOM_MCP_CONFIG     配置文件路径（JSON），见 mcp_servers.example.json
# LOOM_MCP_CALL_TIMEOUT       单次工具调用超时（秒，默认 30）
# LOOM_MCP_START_TIMEOUT      连接/发现超时（秒，默认 15）
# LOOM_MCP_MAX_RESULT_CHARS   单个结果文本上限（默认 12000，超出截断并标记）
# LOOM_MCP_DEBUG=1            把 Server 的 stderr 透传到 Loom 日志（排障用，别长期开）
LOOM_MCP=0
# LOOM_MCP_CONFIG=D:/Loom_agent/loom/mcp_servers.json
# LOOM_MCP_CALL_TIMEOUT=30
# LOOM_MCP_START_TIMEOUT=15
# LOOM_MCP_MAX_RESULT_CHARS=12000

# ---- M5：父子任务（spawn_subtask，首版串行）----
# LOOM_AGENTS=0               关闭子任务能力（registry 里不会有 spawn_subtask）
# LOOM_AGENT_MAX_DEPTH=2      最大派生层级（父=0，子=1）
# LOOM_AGENT_MAX_CHILDREN=3   每个父任务最多派生几个子任务
# LOOM_AGENT_CHILD_TURNS=8    子任务最大轮次（小于父任务，不能派生换预算）
# LOOM_AGENT_CHILD_SECONDS=180
# LOOM_AGENT_CHILD_TOOLS=12
# LOOM_AGENT_APPROVAL_TIMEOUT=60   子任务里等待人工审批的超时（超时=拒绝）
# LOOM_AGENT_TIMEOUT=240           单次派生的总超时

# ---- 终端执行（terminal：宿主机 shell）----
# LOOM_TERMINAL=0            关闭宿主机终端（注册表里就不会有 terminal；run_command 的 Docker 沙箱仍在）
# 说明：terminal 没有沙箱，安全边界是"审批 + 工作区 + 超时 + 输出上限"。
#      单次默认 60s、上限 300s；单条输出上限 6000 字符（由工具参数/常量控制）。
LOOM_TERMINAL=1

# ---- M6：混合检索（关键词 BM25 + 本地向量）----
# LOOM_RAG_EMBED=off     默认只跑关键词；onnx 启用本地 embedding（需 requirements 里的 fastembed）
# LOOM_RAG_MODE          默认检索方式：keyword | semantic | hybrid（search_docs 的 mode=auto 用它）
# LOOM_RAG_EMBED_MODEL   默认 BAAI/bge-small-zh-v1.5（512 维，中文/英文都可）
# LOOM_RAG_EMBED_CACHE   模型缓存目录，默认 <项目根>/sandbox/models/fastembed（已 gitignore）
# LOOM_RAG_CANDIDATES    每路召回候选数（融合前），默认 20
# LOOM_RAG_RRF_K         RRF 平滑常数，默认 60
LOOM_RAG_EMBED=off
LOOM_RAG_MODE=hybrid
# LOOM_RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# LOOM_RAG_CANDIDATES=20
# LOOM_RAG_RRF_K=60
# LOOM_RAG_EMBED_BATCH=32
